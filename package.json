{
  "name": "rawstate-core",
  "version": "1.0.0",
  "description": "Raw state, kept honest: plain data with types, atomic transactions, relations and rules, and checked borders. No dependencies, about 9 KB gzipped.",
  "keywords": [
    "rawstate",
    "raw-state",
    "state",
    "state-management",
    "state-manager",
    "store",
    "typed",
    "typescript",
    "react",
    "transactions",
    "normalized",
    "collections",
    "relations",
    "reactive",
    "observable",
    "immutable",
    "validation",
    "standard-schema",
    "ssr",
    "local-first",
    "devtools"
  ],
  "homepage": "https://github.com/selbstnull/rawstate-core#readme",
  "bugs": {
    "url": "https://github.com/selbstnull/rawstate-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selbstnull/rawstate-core.git"
  },
  "license": "Apache-2.0",
  "author": "nullselbst",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && jest",
    "bench": "tsup && node bench/run.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
